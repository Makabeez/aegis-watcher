# Mainnet settings for a SEPARATE clone of this repo on the `mainnet` branch
# (e.g. C:\Github\aegis-watcher-mainnet). Never share a folder with the Sepolia watcher:
# both write bytecode-cache.json, templates.json and kpi.csv.
# Copy to .env in that folder and fill in the blanks on launch day.

# --- network (fill in when GIWA publishes mainnet details) ---
GIWA_RPC=
GIWA_EXPLORER=
SCAN_REGISTRY=            # from aegis-giwa/deploy/deployments/<chainId>.json

# --- the mainnet app (its own Vercel project with AEGIS_* variables) ---
ANALYZE_URL=https://mainnet.aegisgiwa.com/api/analyze
AEGIS_INTERNAL_KEY=

# --- watcher: full AI scans of verified contracts ---
ATTESTER_KEY=             # fresh key, never the Sepolia one; keep <= 0.01 ETH on it
INTERVAL_MS=120000        # every 2 minutes (Sepolia runs hourly)
PAGES_PER_RUN=1
MAX_PER_RUN=25
MAX_AI_PER_DAY=400        # hard cap on AI scans per UTC day
MIN_BALANCE_ETH=0.002

# --- clone-scout: unverified clones of known templates ---
CLONE_ATTESTER_KEY=       # a second fresh key (separate nonces), <= 0.01 ETH
SCOUT_INTERVAL_MS=60000
SCOUT_BACKFILL=2000       # on first start, look back this many blocks
SCOUT_MAX_ATTEST=100

# --- alerts (same bot as the stale-watch) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
